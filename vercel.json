{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/2019-world-jiu-jitsu-championship-event-shirt",
      "destination": "/work/fighters-market-ibjjf",
      "statusCode": 301
    },
    {
      "source": "/2022-choke-republic-collection",
      "destination": "/work/choke-republic-2022",
      "statusCode": 301
    },
    {
      "source": "/all-roads-counseling",
      "destination": "/work/all-roads-counseling",
      "statusCode": 301
    },
    {
      "source": "/bgd-enterprises",
      "destination": "/work/bgd-enterprises",
      "statusCode": 301
    },
    {
      "source": "/brandon-james-construction",
      "destination": "/work/brandon-james-construction",
      "statusCode": 301
    },
    {
      "source": "/choke-republic-design-tee-design",
      "destination": "/work/choke-republic-tee",
      "statusCode": 301
    },
    {
      "source": "/christopher-d-connors-website",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/david-branch-brazilian-jiu-jitsu-logo",
      "destination": "/work/david-branch",
      "statusCode": 301
    },
    {
      "source": "/guarded-globe",
      "destination": "/work/guarded-globe",
      "statusCode": 301
    },
    {
      "source": "/kingz-balistico-design",
      "destination": "/work/kingz-balistico",
      "statusCode": 301
    },
    {
      "source": "/ladies-winter-boots-poster",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/love-bridal-branding",
      "destination": "/work/love-bridal",
      "statusCode": 301
    },
    {
      "source": "/maeda-akashio",
      "destination": "/work/maeda-akashio",
      "statusCode": 301
    },
    {
      "source": "/maeda-brand-jiu-jitsu-kimono-conde-koma-comeco",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/maeda-red-label",
      "destination": "/work/maeda-red-label",
      "statusCode": 301
    },
    {
      "source": "/orkal-banner",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/orkal-industries",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/pizza-by-certe",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/rollshop-branding",
      "destination": "/work/rollshop",
      "statusCode": 301
    },
    {
      "source": "/ronin-emperor",
      "destination": "/work/ronin-emperor",
      "statusCode": 301
    },
    {
      "source": "/ronin-lonewolf-gi-rashguard",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/shellproof-security",
      "destination": "/work/shellproof-security",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(work|hero|design|clients)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(brand|fonts|logos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
