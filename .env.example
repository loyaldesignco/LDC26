# Sanity project "Loyal" is 9xn8x41p. Leave blank to run on the typed fallback content in src/data/fallback.ts.
# Only set it once the dataset has content (npm run seed + import), or the site builds empty.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-11-01
# Optional: read token for drafts/preview builds (server-side only)
SANITY_API_READ_TOKEN=

# Contact form. Any endpoint that accepts a POST of form fields (Formspree, Basin, a Webflow/Netlify handler).
# Leave blank and the form falls back to opening an email.
PUBLIC_FORM_ENDPOINT=
