---
import { aspectOf, logoMaskUrl } from "@/lib/media";
import type { ClientLogo } from "@/lib/types";

interface Props {
  clients: ClientLogo[];
}
const { clients } = Astro.props;
const items = await Promise.all(
  clients.map(async (c) => ({ name: c.name, url: await logoMaskUrl(c.logo), ar: await aspectOf(c.logo), scale: c.scale ?? 1 })),
);
const row = items.filter((i) => i.url);
---

{
  row.length > 0 && (
    <div class="lp-marquee" data-marquee>
      {[0, 1].map((copy) => (
        <div class="lp-marquee-track" data-marquee-track aria-hidden={copy === 1 ? "true" : undefined}>
          {row.map((c) => (
            <span class="client-logo" role="img" aria-label={c.name} style={`-webkit-mask-image:url('${c.url}');mask-image:url('${c.url}');--ar:${c.ar.toFixed(3)};--s:${c.scale}`} />
          ))}
        </div>
      ))}
    </div>
  )
}
