---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byNewest, categoriesOf, getProjects, getServices } from "@/lib/sanity";
import { src, srcset } from "@/lib/media";

export async function getStaticPaths() {
  const services = (await getServices()).filter((s) => s.slug);
  return services.map((s, i) => ({ params: { slug: s.slug! }, props: { service: s, next: services[(i + 1) % services.length] } }));
}

const { service: s, next } = Astro.props;
const projects = byNewest(await getProjects());
const works = projects.filter((p) => p.cover && (!s.workFilter || categoriesOf(p).includes(s.workFilter))).slice(0, 3);
const grid = Boolean(s.stack?.length);
const pad = (i: number) => String(i + 1).padStart(2, "0");
---

<BaseLayout title={s.title} description={s.statement ?? s.summary} image={src(s.image, 1200, 630) || undefined}>
  <section class="gutter pb-[clamp(56px,8vw,110px)] pt-[clamp(104px,11vw,160px)]">
    <div class="mb-[clamp(20px,3vw,36px)]"><a href="/services" class="mono grad-hover text-[0.7rem] font-bold text-paper/60">← All services</a></div>
    <div data-hud class="mono mb-[clamp(20px,3vw,36px)] flex justify-between gap-4 text-[0.7rem] text-paper/50">
      <span>[ Service ]</span>
      <span>{s.meta}</span>
    </div>
    <h1 data-split class="display-page">{s.title}</h1>
    <div class="mt-[clamp(48px,7vw,96px)] grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-start gap-[clamp(32px,6vw,88px)]">
      {s.statement && <h2 data-split class="display-m max-w-[22ch]">{s.statement}</h2>}
      <div>{s.intro?.map((p, i) => <p data-reveal class:list={["lede max-w-[54ch]", i === 0 ? "m-0" : "mb-0 mt-5"]}>{p}</p>)}</div>
    </div>
  </section>

  {
    !!s.capabilities?.length && (
      <section class="gutter border-t border-paper/12 py-[clamp(72px,10vw,150px)]">
        <p data-reveal class="eyebrow mb-[clamp(32px,5vw,64px)]">[ What we do ]</p>
        {grid ? (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-px border border-paper/12 bg-paper/12">
            {s.capabilities.map((c, i) => (
              <div class="lp-cell" data-reveal>
                <span class="lp-cell-num mono text-paper/55">{pad(i)}</span>
                <h3 class="mb-3 mt-[clamp(28px,4vw,56px)] text-[clamp(1.2rem,1.8vw,1.5rem)] font-bold leading-[1.1] tracking-[-0.02em]">{c.name}</h3>
                <p class="m-0 text-[0.96rem] leading-relaxed text-paper/60">{c.desc}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="border-b border-paper/16">
            {s.capabilities.map((c, i) => (
              <div class="lp-cap" data-reveal>
                <span class="lp-cap-rule" />
                <span class="lp-cap-num mono text-paper/55">{pad(i)}</span>
                <h3 class="m-0 text-[clamp(1.3rem,2.4vw,2rem)] font-bold leading-[1.05] tracking-[-0.025em]">{c.name}</h3>
                <p class="m-0 max-w-[52ch] leading-relaxed text-paper/60">{c.desc}</p>
              </div>
            ))}
          </div>
        )}
      </section>
    )
  }

  {
    !!s.stack?.length && (
      <section class="gutter bg-paper py-[clamp(72px,10vw,150px)] text-ink">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-start gap-[clamp(32px,6vw,88px)]">
          <div>
            <p data-reveal class="eyebrow mb-4 !text-ink/50">[ The stack ]</p>
            <h2 data-split class="display-l max-w-[14ch]">No handoff, no translation layer.</h2>
            <p data-reveal class="mb-0 mt-6 max-w-[44ch] text-[1.05rem] leading-relaxed text-ink/60">The same person who drew the screens builds them. This is what we actually work in, not a partner list.</p>
          </div>
          <ul data-reveal class="m-0 list-none border-b border-ink/15 p-0">
            {s.stack.map((k) => (
              <li class="flex items-baseline justify-between gap-6 border-t border-ink/15 px-2 py-4 transition-colors hover:bg-ink/5">
                <span class="text-[clamp(1.2rem,2vw,1.7rem)] font-bold tracking-[-0.02em]">{k.name}</span>
                <span class="mono text-ink/55">{k.role}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    !!s.steps?.length && (
      <section class="gutter border-t border-paper/12 py-[clamp(72px,10vw,150px)]">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-start gap-[clamp(32px,6vw,88px)]">
          <div>
            <p data-reveal class="eyebrow mb-4">[ How it runs ]</p>
            {s.processTitle && <h2 data-split class="display-l max-w-[16ch]">{s.processTitle}</h2>}
            {s.stats?.length && (
              <div data-reveal class="mt-8 flex flex-wrap gap-2">
                {s.stats.map((st) => <span class="tag !px-3.5 !py-2 !text-[0.64rem]">{st}</span>)}
              </div>
            )}
            <div data-reveal class="mt-[clamp(32px,4vw,56px)] border-b border-paper/16">
              {s.steps.map((st, i) => (
                <details class="lp-acc border-t border-paper/16" open={i === 0}>
                  <summary class="grid grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline gap-4 px-2 py-5">
                    <span class="mono text-paper/55">{pad(i)}</span>
                    <span class="text-[clamp(1.2rem,2vw,1.6rem)] font-bold tracking-[-0.02em]">{st.name}</span>
                    <span class="mono text-paper/50">{st.dur}</span>
                  </summary>
                  <p class="m-0 max-w-[52ch] px-2 pb-6 pl-[calc(3rem+1.5rem)] leading-relaxed text-paper/60">{st.desc}</p>
                </details>
              ))}
            </div>
            <div data-reveal class="mt-[clamp(32px,4vw,48px)] flex flex-wrap gap-3">
              <a href="/contact" class="btn btn-solid">Start a project</a>
              <a href={`/work${s.workFilter ? `?f=${encodeURIComponent(s.workFilter)}` : ""}`} class="btn btn-ghost">See the work</a>
            </div>
          </div>
          {s.image && (
            <div class="top-[110px] md:sticky">
              <div data-reveal data-parallax class="frame aspect-[4/5] rounded-xl">
                <img src={src(s.image, 1280)} srcset={srcset(s.image, 1600)} sizes="(max-width: 900px) 100vw, 50vw" alt={s.image.alt ?? ""} loading="lazy" decoding="async" />
                <div class="wash" />
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    !!s.faq?.length && (
      <section class="gutter border-t border-paper/12 py-[clamp(72px,10vw,150px)]">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-start gap-[clamp(32px,6vw,88px)]">
          <div>
            <p data-reveal class="eyebrow mb-4">[ Straight answers ]</p>
            <h2 data-split class="display-l max-w-[14ch]">The questions everyone asks on the first call.</h2>
          </div>
          <div data-reveal class="border-b border-paper/16">
            {s.faq.map((f, i) => (
              <details class="lp-acc border-t border-paper/16">
                <summary class="grid grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline gap-4 px-2 py-5">
                  <span class="mono text-paper/55">{pad(i)}</span>
                  <span class="text-[clamp(1.1rem,1.8vw,1.4rem)] font-bold tracking-[-0.02em]">{f.q}</span>
                  <span class="lp-acc-sign font-mono text-lg leading-none" aria-hidden="true">+</span>
                </summary>
                <p class="m-0 max-w-[58ch] px-2 pb-6 pl-[calc(3rem+1.5rem)] leading-relaxed text-paper/60">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    works.length > 0 && (
      <section class="gutter border-t border-paper/12 py-[clamp(72px,10vw,150px)]">
        <div class="mb-[clamp(32px,5vw,56px)] flex items-baseline justify-between gap-4">
          <p data-reveal class="eyebrow">[ Selected work ]</p>
          <a href={`/work${s.workFilter ? `?f=${encodeURIComponent(s.workFilter)}` : ""}`} class="mono grad-hover text-paper/60">[ All work → ]</a>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-[clamp(20px,3vw,40px)]">
          {works.map((w) => (
            <article class="lp-ed-card" data-reveal>
              <a href={`/work/${w.slug}`} class="block">
                <div class="frame aspect-[4/5] rounded-[14px]">
                  <img class="lp-ed-base" src={src(w.cover, 900)} alt="" loading="lazy" />
                  <div class="lp-ed-wash pointer-events-none absolute inset-0" />
                </div>
                <div class="mt-3.5 flex items-baseline justify-between gap-4 border-t border-paper/[0.18] pt-3.5">
                  <h3 class="lp-ed-title m-0 text-[clamp(1.1rem,1.6vw,1.35rem)] font-bold tracking-[-0.02em]">{w.title}</h3>
                  {w.launched && <span class="mono text-paper/50">{w.launched}</span>}
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    next && next.slug !== s.slug && (
      <section class="lp-next gutter relative isolate overflow-hidden bg-surface py-[clamp(64px,9vw,130px)]">
        {next.image && <img class="lp-next-bg pointer-events-none absolute inset-0 -z-[2] size-full object-cover" src={src(next.image, 1280)} srcset={srcset(next.image, 2000)} sizes="100vw" alt="" loading="lazy" decoding="async" />}
        <div class="lp-next-veil pointer-events-none absolute inset-0 -z-[1]" />
        <div class="pointer-events-none absolute inset-0 -z-[1] bg-[linear-gradient(to_right,rgba(20,20,20,0.92)_0%,rgba(20,20,20,0.55)_55%,rgba(20,20,20,0.3)_100%)]" />
        <p class="eyebrow mb-4 text-paper/50">[ Next service ]</p>
        <a href={`/services/${next.slug}`} data-roll-link class="inline-block text-[clamp(2.2rem,7vw,6.5rem)] font-bold leading-[0.95] tracking-[-0.04em]">{next.title} →</a>
      </section>
    )
  }
</BaseLayout>
